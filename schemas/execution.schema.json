{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution",
  "type": "object",
  "required": [
    "executionId",
    "runId",
    "testCaseId",
    "environment",
    "status",
    "executedAt"
  ],
  "properties": {
    "executionId": {
      "type": "string",
      "pattern": "^EXE-\\d{8}-\\d{3,}$"
    },
    "testCaseId": {
      "type": "string",
      "pattern": "^TC-\\d{3,}-\\d{3,}$"
    },
    "environment": {
      "type": "string"
    },
    "build": {
      "type": "string"
    },
    "executor": {
      "type": "string"
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "SKIPPED",
        "NOT_RUN"
      ]
    },
    "evidence": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "bugId": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "mode",
        "agent",
        "date"
      ],
      "properties": {
        "mode": {
          "enum": [
            "A",
            "B",
            "C1",
            "C2",
            "C3",
            "manual"
          ]
        },
        "agent": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-\\d{8}-\\d{3,}$"
    },
    "actualResult": {
      "type": "string"
    },
    "stepResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}