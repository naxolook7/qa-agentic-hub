{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestCase",
  "type": "object",
  "required": [
    "id",
    "requirementId",
    "title",
    "type",
    "level",
    "priority",
    "steps",
    "expectedResult",
    "automation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TC-\\d{3,}-\\d{3,}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-\\d{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "enum": [
        "functional",
        "negative",
        "boundary",
        "security",
        "integration",
        "regression",
        "smoke"
      ]
    },
    "level": {
      "enum": [
        "UI",
        "API",
        "E2E"
      ]
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testData": {},
    "steps": {
      "type": "array",
      "minItems": 1
    },
    "expectedResult": {},
    "automation": {
      "enum": [
        "CANDIDATE",
        "MANUAL",
        "DEFERRED"
      ]
    },
    "automationReason": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "mode",
        "agent",
        "date"
      ],
      "properties": {
        "mode": {
          "enum": [
            "A",
            "B",
            "C1",
            "C2",
            "C3",
            "manual"
          ]
        },
        "agent": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}